["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvTGV0aGFsLVdlYXBvbi0yMDE2Lw","type":"series","name":"Lethal Weapon","poster":"https://image.tmdb.org/t/p/w342/grGOtTZ0OfNQoWnNtdJOiY1LB8e.jpg","background":"https://image.tmdb.org/t/p/w780/yqZ5ACKeNJ30mylUEzvtWZu4pGU.jpg","description":"A slightly unhinged former Navy SEAL lands a job as a police officer in Los Angeles where he's partnered with a veteran detective trying to keep maintain a low stress level in his life.","releaseInfo":"2016","genres":["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvTGV0dGVya2VubnktMjAxNi8","type":"series","name":"Letterkenny 2016","description":"Folder: English","releaseInfo":"2016","genres":["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvTG92ZS0yMDE2Lw","type":"series","name":"Love 2016","poster":"https://image.tmdb.org/t/p/w342/wvtW9YoMkovpMqyZCWUbQC6FJlg.jpg","background":"https://image.tmdb.org/t/p/w780/jHaZMdEQVZUKsfE3yCZ1atSXEWw.jpg","description":"Rebellious Mickey and good-natured Gus navigate the thrills and agonies of modern relationships.","releaseInfo":"2016","genres":["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvTHVjaWZlci0yMDE2Lw","type":"series","name":"Lucifer 2016","description":"Folder: English","releaseInfo":"2016","genres":["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvTHVrZS1DYWdlLTIwMTYv","type":"series","name":"Luke Cage","poster":"https://image.tmdb.org/t/p/w342/yzM1hMB3PUJqbISX0f421b3xOjB.jpg","background":"https://image.tmdb.org/t/p/w780/bJOmop22SGTHPo1tiuVAFf4U7B9.jpg","description":"Given superstrength and durability by a sabotaged experiment, a wrongly accused man escapes prison to become a superhero for hire.","releaseInfo":"2016","genres":["English"]},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZf