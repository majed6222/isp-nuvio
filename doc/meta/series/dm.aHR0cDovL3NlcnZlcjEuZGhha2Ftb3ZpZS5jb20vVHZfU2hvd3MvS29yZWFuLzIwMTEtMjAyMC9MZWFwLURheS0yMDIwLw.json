{"meta":{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw","type":"series","name":"Leap Day","poster":"https://image.tmdb.org/t/p/w342/cLSLAtcFMLceRG7VkueNic6Csrn.jpg","background":"https://image.tmdb.org/t/p/w780/nK1I4fKUKJp95p4dudO8HBeb8il.jpg","description":"Yeesa Cheung, born on a leap day, believes her birthday is squeezed between 28 February and 1 March in common years. When she celebrates her birthday in 2017, she unexpectedly travels to 29 February 2020 in Sapporo. There she is greeted by two strangers, Ryan Ma and Yu Ka-chung, and finds her future self killed in a traffic accident. After she returns to 2017, only one second has passed, but the three have now to work together to circumvent their common destiny.","releaseInfo":"2020","genres":["Korean"],"videos":[{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.1","title":"Episode 1","season":1,"episode":1,"released":"2002-09-28T00:00:00.000Z"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.2","title":"Episode 2","season":1,"episode":2,"released":"2002-09-29T00:00:00.000Z"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.3","title":"Episode 3","season":1,"episode":3,"released":"2002-09-30T00:00:00.000Z"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.4","title":"Episode 4","season":1,"episode":4,"released":"2002-10-01T00:00:00.000Z"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.5","title":"Episode 5","season":1,"episode":5,"released":"2002-10-02T00:00:00.000Z"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMTEtMjAyMC9MZWFwLURheS0yMDIwLw.1.6","title":"Episode 6","season":1,"episode":6,"released":"2002-10-03T00:00:00.000Z"},{"id":"dm.aH