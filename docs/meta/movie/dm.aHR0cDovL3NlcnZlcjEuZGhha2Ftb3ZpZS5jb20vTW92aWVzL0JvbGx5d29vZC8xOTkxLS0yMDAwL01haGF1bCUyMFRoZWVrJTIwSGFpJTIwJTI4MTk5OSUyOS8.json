{"meta":{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vTW92aWVzL0JvbGx5d29vZC8xOTkxLS0yMDAwL01haGF1bCUyMFRoZWVrJTIwSGFpJTIwJTI4MTk5OSUyOS8","type":"movie","name":"Mahaul Theek Hai","poster":"https://image.tmdb.org/t/p/w342/9W1qLp9bTfB9wd70K0P7bsyc3as.jpg","background":"https://image.tmdb.org/t/p/w780/fw9O5HM6Mudg3UYcEyp5wZ9Pg9c.jpg","description":"Mahaul Theek Hai (meaning 'the situation is okay') is a comedy satire about the police force in India. The plot involves a romance between the hero (Smeep Kang) and heroine (Chandni Toor). The hero's brother (Raj Babbar) is involved with an illegal businessman. Played by director and satirist Jaspal Bhatti, the villain of the film is a corrupt SSP (police superintendent) who misuses his authority to threaten people and hide his own excesses. His love interest is played by Bhatti's real life wife (Savita Bhatti).","releaseInfo":"1999","genres":["Comedy","Bollywood"],"imdbRating":"8.3","runtime":"149 min","cast":["Jaspal Bhatti","Raj Babbar","Smeep Kang","Chandni Toor","Savita Bhatti","Daljeet Kaur Khangura","Asha Sharma","Sunil Grover"],"director":["Jaspal Bhatti"],"released":"1999-02-14T00:00:00.000Z","app_extras":{"cast":[{"name":"Jaspal Bhatti","character":"SSP Bhatti","photo":"https://image.tmdb.org/t/p/w185/obZtIR5ncTmxARseSqW669TicEU.jpg"},{"name":"Raj Babbar","character":"Inderjeet Rai","photo":"https://image.tmdb.org/t/p/w185/czcJMiNDxfQrNnDPNBM2O6cTmZR.jpg"},{"name":"Smeep Kang","photo":"https://image.tmdb.org/t/p/w185/4AQaHDJdAGfvM6ZY6jB1OkwZPpr.jpg"},{"name":"Chandni Toor","character":"Kiran"},{"name":"Savita Bhatti","character":"Principal"},{"name":"Daljeet Kaur Khangura","photo":"https://image.tmdb.org/t/p/w185/nbVYC9P0JMyWVDsFnYZdP45mmD7.jpg"},{"name":"Asha Sharma","photo":"https://image.tmdb.org/t/p/w185/2ErzHelePxxQXGj8AqeOYywbTKH.jpg"},{"name":"Sunil Grover","photo":"https://image.tmdb.org/t/p/w185/ing2HJHnpvl7uzEQpv5M7NP4XK8.jpg"}]},"trailers":[{"source":"OsHvPzgDAwc","type":"Trailer"}],"trailerStreams"