{"meta":{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vTW92aWVzL0JvbGx5d29vZC8yMDAxLS0yMDEwL0ZpcmFhcSUyMCUyODIwMDglMjkv","type":"movie","name":"Firaaq","description":"Firaaq is an Urdu word that means both separation and quest. The film is a work of fiction, based on a thousand stories. The story is set over a 24-hour period, one month after a campaign that took place in Gujarat, India, in 2002. It traces the emotional journey of ordinary people- some who were victims, some perpetrators and some who choose to watch silently.","releaseInfo":"2008","genres":["Drama","Bollywood"],"poster":"https://image.tmdb.org/t/p/w342/6p7eoDgHughtjhr2O3Akkbt1165.jpg","background":"https://image.tmdb.org/t/p/w780/ig4YEivtgePAKLms4bEzuR475m4.jpg","imdbRating":"6.2","runtime":"101 min","cast":["Naseeruddin Shah","Paresh Rawal","Inaamulhaq","Nassar","Shahana Goswami","Nawazuddin Siddiqui","Honey Chhaya","Deepti Naval"],"director":["Nandita Das"],"released":"2009-03-20T00:00:00.000Z","app_extras":{"cast":[{"name":"Naseeruddin Shah","character":"Khan Sahab","photo":"https://image.tmdb.org/t/p/w185/iaRC8eqliA5clpsQ50sITYoNQGG.jpg"},{"name":"Paresh Rawal","character":"Sanjay","photo":"https://image.tmdb.org/t/p/w185/xFVHMvDC8s4Ab2sLXrdVxMxZ33b.jpg"},{"name":"Inaamulhaq","character":"Munna","photo":"https://image.tmdb.org/t/p/w185/uDxMy901mwdamRdNnQft36Q8Xi.jpg"},{"name":"Nassar","character":"Grave digger","photo":"https://image.tmdb.org/t/p/w185/p3I0tSQY3C5qZW3NzFfbpjKPNL6.jpg"},{"name":"Shahana Goswami","character":"Muneera","photo":"https://image.tmdb.org/t/p/w185/huexJWjPKR940RPiUAtXyzkx6Jf.jpg"},{"name":"Nawazuddin Siddiqui","character":"Hanif","photo":"https://image.tmdb.org/t/p/w185/w1eXF7T60QlEC2gNfr99J3n8CgX.jpg"},{"name":"Honey Chhaya","character":"Bapuji","photo":"https://image.tmdb.org/t/p/w185/wskMvXguBi7r0ya4vpXJESVPmtY.jpg"},{"name":"Deepti Naval","character":"Arati","photo":"https://image.tmdb.org/t/p/w185/6G0miCgpQcXVJqsY7nt1wPn4evK.jpg"},{"name":"Dilip Joshi","character"