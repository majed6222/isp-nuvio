os":[{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.1","title":"Episode 1","season":1,"episode":1,"released":"2016-02-21T00:00:00.000Z","overview":"Hotel night manager Jonathan Pine receives a plea for help from a well-connected guest.","thumbnail":"https://image.tmdb.org/t/p/w300/4ng5mLHyrxMI8zRHoSJJqplNkmc.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.2","title":"Episode 2","season":1,"episode":2,"released":"2016-02-28T00:00:00.000Z","overview":"On the Mediterranean island of Mallorca, Roper’s life of luxury and calm is shattered. Six months earlier, Burr continues her recruitment of Pine, sending him to Devon to build his cover story.","thumbnail":"https://image.tmdb.org/t/p/w300/hRjoOwWuFzZijYRbmB8yXSvKJIz.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.3","title":"Episode 3","season":1,"episode":3,"released":"2016-03-06T00:00:00.000Z","overview":"While he continues to recuperate in Roper’s villa, Pine starts to dig up secrets about the other members of the household. Meanwhile, Burr and Steadman seize on an opportunity to recruit a new asset.","thumbnail":"https://image.tmdb.org/t/p/w300/v0UGr8jALT2YE2SZEtYHsxBhHmC.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.4","title":"Episode 4","season":1,"episode":4,"released":"2016-03-13T00:00:00.000Z","overview":"Roper welcomes Pine into his inner circle, leaving Corky out in the cold. Meanwhile, Burr has concerns for the safety of her source, when she suspects key information has been leaked to the River House.","thumbnail":"https://image.tmdb.org/t/p/w300/51H0MmEvnO0bXh6k4FWiasHTscz.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.5","title":"Episode 5","season":1,"episode":5,"released":"2016-03-20T00:00:00.000Z","overview":"A suspicious Roper gathers his entourage around him in an attempt to root out the traitor, forcing Pine to play a dangerous game. In London, Burr and Steadman face mounting opposition from Whitehall.","thumbnail":"https://image.tmdb.org/t/p/w300/r6z5AsiwK9Er0z0LbSxLJIAtmU4.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.1.6","title":"Episode 6","season":1,"episode":6,"released":"2016-03-27T00:00:00.000Z","overview":"Roper and his team return to Cairo for the deal, reuniting Pine with an old enemy. Pine risks it all to put his plan in motion. A discredited Burr makes one last stand.","thumbnail":"https://image.tmdb.org/t/p/w300/fYXi80kLHo96Yq28QrpuRx01C0I.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.1","title":"Episode 1","season":2,"episode":1,"released":"2026-01-01T00:00:00.000Z","overview":"Pine's past resurfaces after a chance sighting. He's pulled into a deadly conspiracy reaching from Colombia's jungles to the heart of MI6.","thumbnail":"https://image.tmdb.org/t/p/w300/cSlQHQ8oah5yrMrgzl93FuYhppi.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.2","title":"Episode 2","season":2,"episode":2,"released":"2026-01-04T00:00:00.000Z","overview":"Pine is on the run and using a new identity. Under the name Matthew Ellis, he travels to Colombia to get inside Teddy dos Santos's operation and uncover the mystery of the Cartagena shipment.","thumbnail":"https://image.tmdb.org/t/p/w300/qLi8AHz6CD0uhd8FZ74aClHATqc.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.3","title":"Episode 3","season":2,"episode":3,"released":"2026-01-11T00:00:00.000Z","overview":"Pine gains Teddy's trust and secretly finds the proof he needs to connect the Cartagena shipment to covert British intelligence interests. But then things start to go wrong.","thumbnail":"https://image.tmdb.org/t/p/w300/3RJzYuH7llNUDiwaAkksVhdiR0N.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.4","title":"Episode 4","season":2,"episode":4,"released":"2026-01-18T00:00:00.000Z","overview":"Pine has the proof he needs to expose the British-backed overthrow of the Colombian government. But Teddy no longer trusts Matthew Ellis, and Gilberto Hanson is on his tail.","thumbnail":"https://image.tmdb.org/t/p/w300/4ne2Z5JZCv8CPQPIHtfDOZcFYER.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.5","title":"Episode 5","season":2,"episode":5,"released":"2026-01-25T00:00:00.000Z","overview":"Matthew Ellis has been exposed, and Pine can no longer run. He meets Gilberto Hanson and offers a deal. Then, Pine covertly starts to work on Teddy and dismantle the Colombia operation from within.","thumbnail":"https://image.tmdb.org/t/p/w300/5IQiSqUIrzLWZxGYWI1ytAZ1CY9.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU5pZ2h0LU1hbmFnZXItJTI4VFYtTWluaS1TZXJpZXMtMjAxNiUyOS0xMDgwcC8.2.6","title":"Episode 6","season":2,"episode":6,"released":"2026-02-01T00:00:00.000Z","overview":"Pine works with Teddy to bring down Gilberto Hanson’s Colombia coup from the inside. But Hanson has found a new ally of his own. It is winner-takes-all.","thumbnail":"https://image.tmdb.org/t/p/w300/cUnUDWSwtmMg3SHthk2REWch5lS.jpg"}]}}