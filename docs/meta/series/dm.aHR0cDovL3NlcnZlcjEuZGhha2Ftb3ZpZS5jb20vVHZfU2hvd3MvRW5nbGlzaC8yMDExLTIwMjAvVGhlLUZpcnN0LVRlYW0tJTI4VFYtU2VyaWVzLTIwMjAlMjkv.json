CTWOmIZuwXGJa9OJ9xm.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLUZpcnN0LVRlYW0tJTI4VFYtU2VyaWVzLTIwMjAlMjkv.1.5","title":"Pints of Sorry","season":1,"episode":5,"released":"2020-06-25T00:00:00.000Z","overview":"The Chairman announces a caretaker manager. After a poor start the team is forced to attend a pub night as an apology to the fans. Benji employs a social media manager.","thumbnail":"https://image.tmdb.org/t/p/w300/7ksdtBDVigqz7AWkYzVFVRaU4Sh.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLUZpcnN0LVRlYW0tJTI4VFYtU2VyaWVzLTIwMjAlMjkv.1.6","title":"Upheaval","season":1,"episode":6,"released":"2020-07-02T00:00:00.000Z","overview":"Petey plots to bring an end to Chris Booth’s run of success. Meanwhile Jack gets a girlfriend and plans a romantic surprise. Benji has had enough of his social media manager.","thumbnail":"https://image.tmdb.org/t/p/w300/jG3uxZFxo1tADIx2pdUzzwoWPiF.jpg"}]}}