3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDExLTIwMjAvVGhlLU91dHNpZGVyLTIwMjAv"}],"videos":[{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.1","title":"When God Was Love","season":1,"episode":1,"released":"2022-04-28T00:00:00.000Z","overview":"Detectives Jeb Pyre and Bill Taba investigate the brutal, sinister murders of an LDS woman, Brenda Wright Lafferty and her baby daughter in Utah’s typically serene Salt Lake Valley in 1984.","thumbnail":"https://image.tmdb.org/t/p/w300/9k3Czppp4T4iIO6RUEEpxJW0lCP.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.2","title":"Rightful Place","season":1,"episode":2,"released":"2022-04-28T00:00:00.000Z","overview":"With a lead suspect in custody, the investigation uncovers more ominous questions than answers as the hidden history of the once admired Lafferty family is exposed.","thumbnail":"https://image.tmdb.org/t/p/w300/4jVK08t6ATR2N4NqA77FjpekQLJ.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.3","title":"Surrender","season":1,"episode":3,"released":"2022-05-05T00:00:00.000Z","overview":"The ongoing investigation leads Pyre and Taba into untrod woods where they unearth information that challenges Pyre's own faith, and draw more Laffertys into suspicion and custody.","thumbnail":"https://image.tmdb.org/t/p/w300/8jvPpsj6kRLjCEhSLsLWuse8VV5.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.4","title":"Church and State","season":1,"episode":4,"released":"2022-05-12T00:00:00.000Z","overview":"The investigation intensifies after Pyre uncovers details of the Lafferty family's fundamentalist beliefs, sparking a search for missing Lafferty brothers, Ron and Dan, and putting Pyre at odds with his own church leaders.","thumbnail":"https://image.tmdb.org/t/p/w300/ayAOl7kcBva2XPTJEVkELanUAlI.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.5","title":"One Mighty and Strong","season":1,"episode":5,"released":"2022-05-19T00:00:00.000Z","overview":"With evidence now pointing squarely toward fundamentalist Mormonism, Pyre turns to LDS Church leaders for guidance but is met with roadblocks. Undeterred, he discovers a list of names Brenda's killers plan to murder next.","thumbnail":"https://image.tmdb.org/t/p/w300/qwswo5IQWq2ZasnJWC5kCPyWd5u.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.6","title":"Revelation","season":1,"episode":6,"released":"2022-05-26T00:00:00.000Z","overview":"New details emerge about Brenda's attempt to reckon with some of the Lafferty family's most extreme members and beliefs, as Pyre and Taba hunt for those who killed Brenda before they can kill again.","thumbnail":"https://image.tmdb.org/t/p/w300/nVydchK5mhRvIpoLIVKgfoOUkR9.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvRW5nbGlzaC8yMDIyL1VuZGVyLXRoZS1CYW5uZXItb2YtSGVhdmVuLTIwMjIv.1.7","title":"Blood Atonement","season":1,"episode":7,"released":"2022-06-02T00:00:00.000Z","overview":"As the details of the murders become clear, Pyre and Taba embark on an interstate manhunt, hoping to catch the killers before they complete their list of those to be \"blood atoned.\"","thumbnail":"https://image.tmdb.org/t/p/w300/lQML0to8xNyXCWEBFuw08v4b8Y1.jpg"}]}}