.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMjUvVGhlJTIwUHJpY2UlMjBvZiUyMENvbmZlc3Npb24lMjAlMjgyMDI1JTI5Lw.1.10","title":"Episode 10","season":1,"episode":10,"released":"2025-12-05T00:00:00.000Z","overview":"A tense confrontation with Jeong-gu, Baek and Mo Eun reveals vital withheld information about the case. A shocking murder confession hits the news.","thumbnail":"https://image.tmdb.org/t/p/w300/pRT1Uq7lAwVpzpjpNOzaBdYpshy.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMjUvVGhlJTIwUHJpY2UlMjBvZiUyMENvbmZlc3Npb24lMjAlMjgyMDI1JTI5Lw.1.11","title":"Episode 11","season":1,"episode":11,"released":"2025-12-05T00:00:00.000Z","overview":"A hidden motive — and fingerprint — in Lee Ki-dae's murder case leads to an unlikely source. Mo Eun orchestrates a plan after news of a kidnapping.","thumbnail":"https://image.tmdb.org/t/p/w300/4o54LEH3tZQFBesu5Kf4V7qsvqN.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvS29yZWFuLzIwMjUvVGhlJTIwUHJpY2UlMjBvZiUyMENvbmZlc3Npb24lMjAlMjgyMDI1JTI5Lw.1.12","title":"Episode 12","season":1,"episode":12,"released":"2025-12-05T00:00:00.000Z","overview":"As the pieces start falling into place in both murder cases, Baek and Jeong-gu receive a chilling video. Mo Eun has a final message for Yun-su.","thumbnail":"https://image.tmdb.org/t/p/w300/55EJRkLmQILkoZ2AJILHLv7IIW4.jpg"}]}}