ika Apte","Kani Kusruti","Jackie Shroff","Ratnabali Bhattacharjee","Sarang Sathaye","Rasika Dugal","Ullas Mohan"],"director":["Pooja Shetty","Neil Pagedar"],"released":"2021-03-26T00:00:00.000Z","app_extras":{"cast":[{"name":"Pooja Shetty","character":"Director"},{"name":"Vijay Varma","character":"Saajan Kundu","photo":"https://image.tmdb.org/t/p/w185/A46ekiPFC3vA1442FJmiIudpxX1.jpg"},{"name":"Radhika Apte","character":"Laxmi Suri","photo":"https://image.tmdb.org/t/p/w185/wKPybRcSYcbgDiJZwELudrRNf0r.jpg"},{"name":"Kani Kusruti","character":"Monalisa Paul","photo":"https://image.tmdb.org/t/p/w185/qKrzVIeTuGBDlWZi1g6LafzqkrL.jpg"},{"name":"Jackie Shroff","character":"Pushpak Shakur","photo":"https://image.tmdb.org/t/p/w185/sVqe6VioM37LQwgQLd8wnC5vapK.jpg"},{"name":"Ratnabali Bhattacharjee","character":"Trisha Singh","photo":"https://image.tmdb.org/t/p/w185/xH0c8XXkEFQ3y3IxT2qPmimLws1.jpg"},{"name":"Sarang Sathaye","character":"Ashfaq Auliya","photo":"https://image.tmdb.org/t/p/w185/rTSaN5vsv4SCnkVdUYkRZH4Q3C.jpg"},{"name":"Rasika Dugal","character":"Satoshi","photo":"https://image.tmdb.org/t/p/w185/hDLEHqYoIY6ZGrbmlsUJpwn9nl3.jpg"},{"name":"Ullas Mohan","character":"Ajeeb"},{"name":"Alok Ulfat","character":"Nigel Paudwal"},{"name":"Vibha Chibber","character":"Deepa Chandra Prasad","photo":"https://image.tmdb.org/t/p/w185/3UIRA4TKnlcR4lGtkIH6KCCULSZ.jpg"}]},"trailers":[{"source":"KTMNI98YVBI","type":"Trailer"}],"trailerStreams":[{"title":"Trailer: Hotstar Specials OK Computer | Trailer I Vijay Varma, Radhika Apte, Jackie Shroff, Anand Gandhi","ytId":"KTMNI98YVBI"}],"writer":["Anand Gandhi","Neil Pagedar","Pooja Shetty"],"country":"India","language":"Hindi","links":[{"name":"Vijay Varma","category":"Cast","url":"stremio:///search?search=Vijay%20Varma"},{"name":"Radhika Apte","category":"Cast","url":"stremio:///search?search=Radhika%20Apte"},{"name":"Kani Kusruti","category":"Cast","url":"stremio:///search?search=Kani%20Kusruti"},{"name":"Jackie Shroff","category":"Cast"