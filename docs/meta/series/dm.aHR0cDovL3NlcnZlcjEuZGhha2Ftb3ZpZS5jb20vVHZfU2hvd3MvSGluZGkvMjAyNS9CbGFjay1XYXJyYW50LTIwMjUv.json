300/8OxECTuoPyumhBGNySuwZHeACLD.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9CbGFjay1XYXJyYW50LTIwMjUv.1.7","title":"Double Life Sentence","season":1,"episode":7,"released":"2025-01-10T00:00:00.000Z","overview":"As nationwide riots break out, the prison falls into disarray and Tomar's leadership is questioned. Sobhraj asks Sunil for a favor.","thumbnail":"https://image.tmdb.org/t/p/w300/7tKnqw5TTf5nuANGdY18H1ky71i.jpg"}]}}