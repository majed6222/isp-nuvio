RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.1","title":"Kickoff","season":1,"episode":1,"released":"2025-12-08T00:00:00.000Z","overview":"Disillusioned with journalism, Sohail wants to change Kashmir for the better by starting a professional football club. He attempts to recruit his oldest friend Mustafa to coach RKFC and solicits funding from businessman Shirish - who knows nothing about football.","thumbnail":"https://image.tmdb.org/t/p/w300/qaKliTZY50cuplMYMdFF2sL9Yjq.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.2","title":"Pressing","season":1,"episode":2,"released":"2025-12-08T00:00:00.000Z","overview":"With financier Shirish and coach Mustafa onboard, and having selected a squad of players, Sohail must take care of formalities to ensure RKFC complies with league requirements.","thumbnail":"https://image.tmdb.org/t/p/w300/kPIU6ejHbhs5Ksp8V8ReiTcCdN1.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.3","title":"In Possession","season":1,"episode":3,"released":"2025-12-08T00:00:00.000Z","overview":"In order to be accepted into a league-qualifying tournament, RKFC must recruit local star Shah - which proves difficult for Sohail as Shah has a confrontational history with Mustafa.","thumbnail":"https://image.tmdb.org/t/p/w300/ks8NPQdawwL2azQ8o2cf7GLtciR.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.4","title":"Transition To Defence","season":1,"episode":4,"released":"2025-12-08T00:00:00.000Z","overview":"Shah joins the club and they travel to Delhi for the tournament, where things couldn't go worse - both on and off the field.","thumbnail":"https://image.tmdb.org/t/p/w300/8kipgQDZQ10umI0zy9M6mktTUO0.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.5","title":"Own-Goal","season":1,"episode":5,"released":"2025-12-08T00:00:00.000Z","overview":"After the Delhi fiasco, strife has increased and it appears that various players have dropped. Sohail must find a way to keep Mustafa, re-sign Shah, and appease Shirish, who now wants to be more involved with club management.","thumbnail":"https://image.tmdb.org/t/p/w300/ytQywal1cL74UO7tZEqQd6WVIVf.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.6","title":"Regroup","season":1,"episode":6,"released":"2025-12-08T00:00:00.000Z","overview":"After Sohail agrees with Shirish that they should bring in an international coach to increase RKFC's chances for success, it gets ugly when he informs Mustafa of this decision.","thumbnail":"https://image.tmdb.org/t/p/w300/1KA8l4y2igpyExbtPMxiG2hRmT3.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.7","title":"Counterattack","season":1,"episode":7,"released":"2025-12-08T00:00:00.000Z","overview":"After international coach Douglas arrives and sees what a challenge it is to mount a club in Srinagar, Sohail and Shirish slowly move the club closer to league qualification.","thumbnail":"https://image.tmdb.org/t/p/w300/fO1EVx2SoplNDdLwhOkdOFVmd9w.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWFsJTIwS2FzaG1pciUyMEZvb3RiYWxsJTIwQ2x1YiUyMCUyODIwMjUlMjkv.1.8","title":"Goal!","season":1,"episode":8,"released":"2025-12-08T00:00:00.000Z","overview":"When the players learn that RKFC's pathway to qualification is to play a security forces team at the local cantonment, a debate ensues as to whether they should participate in the match or not.","thumbnail":"https://image.tmdb.org/t/p/w300/Z1Vs4kTjut20dTBjErTFsvdtac.jpg"}]}}