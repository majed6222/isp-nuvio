d":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWdhaSUyMCUyODIwMjUlMjkv.1.4","title":"Divya's Escape","season":1,"episode":4,"released":"2025-11-28T00:00:00.000Z","overview":"Vetri and Sandhya nab Divya, who attacks them during interrogation. The forensic department cracks open Amudhan's phone and finds the fifth victim. Divya escapes the hospital after injuring Sandhya.","thumbnail":"https://image.tmdb.org/t/p/w300/kEhDIDjpHNQEmWztnizLmdSvjCQ.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWdhaSUyMCUyODIwMjUlMjkv.1.5","title":"The Clinical Crime","season":1,"episode":5,"released":"2025-11-28T00:00:00.000Z","overview":"An unconscious Sandhya is taken away from the hospital. On the other hand, Vetri nabs Divya, who is trying to kill the mortuary attendant. Divya confesses to the crimes, but Vetri gets a threat call.","thumbnail":"https://image.tmdb.org/t/p/w300/rCycA26jp47uWfa1jyBQcxwjtKW.jpg"},{"id":"dm.aHR0cDovL3NlcnZlcjEuZGhha2Ftb3ZpZS5jb20vVHZfU2hvd3MvSGluZGkvMjAyNS9SZWdhaSUyMCUyODIwMjUlMjkv.1.6","title":"And That's How She Died","season":1,"episode":6,"released":"2025-11-28T00:00:00.000Z","overview":"Divya, scared for her life, reveals the main culprit behind the illegal drug trials. As Vetri runs to save Sandhya, he has a masterplan prepared to arrest the one who killed Amudhan and his friends.","thumbnail":"https://image.tmdb.org/t/p/w300/14oeQCKIASPopwmaIZMNCVcuznJ.jpg"}]}}